# MySQL connection string. JAWSDB_URL (Heroku) takes precedence over LOCAL_URL.
# Use a dedicated user limited to this one database, not root.
LOCAL_URL=mysql://deal_tracker:change-me@localhost:3306/deal_tracker
PORT=3000
# Set to true for one run to apply model changes to existing tables, then remove.
# Back up first (see README).
# DB_SYNC_ALTER=true
# Long random string used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me
# Separate database for `npm test`. Its name must end in _test; tests wipe it.
TEST_DATABASE_URL=mysql://deal_tracker:change-me@localhost:3306/deal_tracker_test
